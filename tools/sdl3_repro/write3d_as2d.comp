#version 450
// The HYPOTHESIS: SDL3's StorageTextureReadWriteBinding carries a `layer`, so a
// 3D texture may be bound one Z SLICE at a time — which would make the shader
// see a 2D image, not a 3D one.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 1, binding = 0, r32ui) uniform uimage2D slice;
void main() {
    imageStore(slice, ivec2(gl_GlobalInvocationID.xy), uvec4(1u, 0u, 0u, 0u));
}
